{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://filmfoundry.dev/schemas/location-coverage-set.v3.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "coverage_id", "location_id", "views", "review_status"],
  "properties": {"schema_version": {"const": "location-coverage-set.v3"}, "coverage_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "location_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}}, "review_status": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}},
  "$defs": {"view": {"type": "object", "additionalProperties": false, "required": ["view_id", "node_id", "camera_side", "screen_direction", "visible_anchor_ids", "occluded_anchor_ids", "framing_result", "source_asset_id", "qc_status"], "properties": {"view_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "node_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "camera_side": {"type": "string", "minLength": 1}, "screen_direction": {"type": "string", "minLength": 1}, "visible_anchor_ids": {"type": "array", "items": {"type": "string"}}, "occluded_anchor_ids": {"type": "array", "items": {"type": "string"}}, "framing_result": {"type": "string", "minLength": 1}, "source_asset_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "qc_status": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}}}}
}
