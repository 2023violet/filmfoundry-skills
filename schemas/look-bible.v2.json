{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://filmfoundry.dev/schemas/look-bible.v2.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "look_id", "scope", "reference_sources", "composition_language", "camera_behavior", "palette", "contrast", "saturation", "color_temperature", "light_direction", "light_quality", "weather", "skin_tone_protection", "does_not_control", "review_status"],
  "properties": {"schema_version": {"const": "look-bible.v2"}, "look_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "scope": {"type": "string", "minLength": 1}, "reference_sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "composition_language": {"type": "string", "minLength": 1}, "camera_behavior": {"type": "string", "minLength": 1}, "palette": {"type": "array", "items": {"type": "string", "minLength": 1}}, "contrast": {"type": "string", "minLength": 1}, "saturation": {"type": "string", "minLength": 1}, "color_temperature": {"type": "string", "minLength": 1}, "light_direction": {"type": "string", "minLength": 1}, "light_quality": {"type": "string", "minLength": 1}, "weather": {"type": "string", "minLength": 1}, "skin_tone_protection": {"type": "string", "minLength": 1}, "does_not_control": {"type": "string", "minLength": 1}, "review_status": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}},
  "$defs": {"source": {"type": "object", "additionalProperties": false, "required": ["source_id", "description", "rights_status"], "properties": {"source_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "rights_status": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}}}}
}
