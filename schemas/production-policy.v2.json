{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmfoundry.dev/schemas/production-policy.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "requirements"],
  "properties": {
    "schema_version": {"const": "production-policy.v2"},
    "policy_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "requirement": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "artifact_type", "description"], "properties": {"requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "artifact_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "description": {"type": "string", "minLength": 1}, "severity": {"enum": ["ERROR", "WARNING"]}, "required_when": {"type": "object"}, "extensions": {"type": "object"}}}
  }
}
