{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://filmfoundry.dev/schemas/scene-topology.v2.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "topology_id", "location_id", "nodes", "movement_paths", "review_status"],
  "properties": {"schema_version": {"const": "scene-topology.v2"}, "topology_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "location_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}, "movement_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "review_status": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}},
  "$defs": {"node": {"type": "object", "additionalProperties": false, "required": ["node_id", "node_type", "adjacent_nodes", "entrances", "exits", "floor", "elevation", "orientation", "anchor_ids", "light_sources", "camera_side_regions"], "properties": {"node_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "node_type": {"type": "string", "minLength": 1}, "adjacent_nodes": {"type": "array", "items": {"type": "string"}}, "entrances": {"type": "array", "items": {"type": "string"}}, "exits": {"type": "array", "items": {"type": "string"}}, "floor": {"type": "string", "minLength": 1}, "elevation": {"type": "string", "minLength": 1}, "orientation": {"type": "string", "minLength": 1}, "anchor_ids": {"type": "array", "items": {"type": "string"}}, "light_sources": {"type": "array", "items": {"type": "string"}}, "camera_side_regions": {"type": "array", "items": {"type": "string"}}, "extensions": {"type": "object"}}}, "path": {"type": "object", "additionalProperties": false, "required": ["path_id", "subject_id", "node_ids", "anchor_ids", "screen_direction"], "properties": {"path_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "subject_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "node_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "anchor_ids": {"type": "array", "items": {"type": "string"}}, "screen_direction": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}}}}
}
