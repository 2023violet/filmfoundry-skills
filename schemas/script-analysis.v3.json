{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmfoundry.dev/schemas/script-analysis.v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "script_analysis_id", "source_script", "facts", "unresolved_questions", "review_status"],
  "properties": {
    "schema_version": {"const": "script-analysis.v3"},
    "script_analysis_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "source_script": {"$ref": "#/$defs/source"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_status": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "extensions": {"type": "object"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "category", "value", "source_span", "evidence_level", "confidence", "confirmed_by", "status"], "properties": {"fact_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "category": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "source_span": {"type": "string", "minLength": 1}, "evidence_level": {"enum": ["EXPLICIT_SCRIPT_FACT", "CREATOR_CONFIRMED", "INFERRED", "UNKNOWN", "CONFLICT"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "confirmed_by": {"type": ["string", "null"]}, "status": {"enum": ["ACTIVE", "CANON", "REJECTED", "UNRESOLVED"]}, "extensions": {"type": "object"}}}
  }
}
