{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filmfoundry.dev/schemas/visual-control-plan.v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["visual_control_id", "production_unit", "character_references", "scale_references", "physics_cues", "review_status", "experiment_ids"],
  "properties": {
    "visual_control_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "production_unit": {"type": "string"},
    "character_references": {"type": "array", "items": {"$ref": "character-reference.v3.json"}},
    "location_reference": {"anyOf": [{"$ref": "location-reference.v3.json"}, {"type": "null"}]},
    "spatial_map": {"anyOf": [{"$ref": "spatial-map.v3.json"}, {"type": "null"}]},
    "scale_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["subject_id", "reference_object_id", "visible_relation", "intended_scale", "scale_confidence"], "properties": {"subject_id": {"type": "string"}, "reference_object_id": {"type": "string"}, "visible_relation": {"type": "string"}, "intended_scale": {"type": "string"}, "scale_confidence": {"type": "string"}}}},
    "physics_cues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["material", "force", "weight", "inertia", "gravity", "observable_result"], "properties": {"material": {"type": "string"}, "force": {"type": "string"}, "weight": {"type": "string"}, "inertia": {"type": "string"}, "gravity": {"type": "string"}, "observable_result": {"type": "string"}}}},
    "previsualization": {"type": ["object", "null"]},
    "lens_result": {"type": ["object", "null"]},
    "review_status": {"type": "string"},
    "experiment_ids": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"}
  }
}
